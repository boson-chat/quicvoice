{
  "name": "quicvoice-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "proto": "protoc -I ../proto --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts ../proto/control.proto",
    "build": "tsc --noEmit && esbuild src/demo.ts --bundle --format=esm --target=chrome120 --outfile=dist/demo.js && cp src/index.html dist/index.html",
    "test": "playwright test"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
